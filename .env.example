# ---- Fontes de video (gratuitas, basta cadastrar) ----
# https://www.pexels.com/api/  -> gratis, ilimitado para uso normal
PEXELS_API_KEY=
# https://pixabay.com/api/docs/ -> gratis
PIXABAY_API_KEY=

# ---- LLM (escolha UM) ----
# ollama  = local, 100% offline e gratis (padrao)
# groq    = nuvem, free tier generoso, muito mais rapido
# gemini  = nuvem, free tier
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434
GROQ_API_KEY=
GEMINI_API_KEY=

# ---- Telegram (opcional) ----
# Fale com @BotFather no Telegram para criar o bot e pegar o token
TELEGRAM_BOT_TOKEN=
# Seu user id numerico (fale com @userinfobot). So voce podera usar o bot.
TELEGRAM_ALLOWED_USER_IDS=

# ---- YouTube ----
# Console Google Cloud -> ative "YouTube Data API v3" -> credencial OAuth Desktop
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=token.json
# public | unlisted | private
YOUTUBE_PRIVACY=private
